# Kopyala: .env — yerel geliştirmede BOŞ bırak. src/api.ts, Expo Go/dev build'de
# Metro'nun bağlı olduğu adresi (Constants.expoConfig.hostUri) otomatik
# kullanıyor, LAN IP'ni elle yazmana gerek yok ve IP değişse (DHCP) bile
# bozulmaz. Sadece prod/staging build'inde gerçek bir domain'e sabitlemek
# istediğinde doldur (EAS Build'de eas.json'daki env bloğu/EAS secrets ile
# de geçilebilir).

EXPO_PUBLIC_API_URL=

# RevenueCat hesabı kurulunca dashboard'dan alınan platforma özel public
# API key'ler (bkz. src/purchases.ts) — boş bırakılırsa satın alma
# tamamen no-op olur, PremiumScreen dev-toggle'a düşer, çökmez.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
